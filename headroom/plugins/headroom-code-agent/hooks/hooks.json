{
  "description": "Headroom code agent hooks — keep the code agent's skills current, add a brief under each prompt, run each edited file's own checks after every edit, and digest the open task before compaction so it survives into the session on the other side.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent skills-ensure",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent digest-inject",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent digest-save",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent brief",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__headroom__Edit",
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent check",
            "timeout": 150
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "headroom code-agent check",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
